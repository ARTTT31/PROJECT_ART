[TEMPLATE]
# ============================================================================
# ART Workspace — combined environment reference
# ----------------------------------------------------------------------------
# Backend:  copy the backend section into `backend/.env`
# Frontend: copy the frontend section into `frontend/.env.local`
# Never commit real .env files.
# ============================================================================

# ── Backend (.env) ───────────────────────────────────────────────────────────
APP_NAME="ART Workspace API"
APP_VERSION="1.0.0"
# Use True only for local development. Keep False on deployed environments.
DEBUG=True

DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/art_workspace

# JWT signing key. With DEBUG=False it must be at least 32 characters and must
# not be a known placeholder, or the API refuses to start.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="replace_with_a_long_random_secret"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie posture. `SameSite=None` is only accepted together with Secure/HTTPS;
# over plain local HTTP the backend downgrades it to `lax` automatically so the
# session cookie is not silently dropped.
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Local-development convenience only. The schema is owned by Alembic
# (`cd backend && alembic upgrade head`).
AUTO_CREATE_TABLES=False

# CSRF protection for cookie-authenticated writes (double-submit cookie).
# Disable only for non-browser API clients that cannot send X-CSRF-Token.
CSRF_PROTECTION_ENABLED=True
# Serve /docs, /redoc and /openapi.json. Always on when DEBUG=True.
ENABLE_API_DOCS=False

# Rate-limit storage. "memory://" is process-local and correct for a single
# instance; set a redis:// URI before scaling to more than one instance.
SLOWAPI_STORAGE_URI=memory://
# Per-IP request limits (requests per minute). Auth endpoints are the
# strictest; the avatar upload gets its own, tighter bucket because it is
# the heaviest authenticated write.
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_GENERAL_PER_MINUTE=120
RATE_LIMIT_WEATHER_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=5

# Who may create an account: closed (default — only an admin can), approval
# (anyone may request one; it stays inactive until an admin approves) or open
# (self-registration works immediately).
REGISTRATION_MODE=closed
# How long a deleted account stays in the admin panel's trash before it is
# purged for good. While it is there the admin can restore it, and its
# email/username stay reserved so the account returns to the same identity.
USER_DELETE_RETENTION_DAYS=30
# In production, replace localhost with the one exact frontend origin you use.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

FRONTEND_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Google OAuth client IDs accepted as a token audience (comma-separated; web
# and mobile clients have different IDs). With none set, Google sign-in fails
# closed.
GOOGLE_VALID_CLIENT_IDS=""
# Domains allowed to sign in with Google (comma-separated, e.g. example.co.th).
# WARNING: while this is empty, Google sign-in accepts ANY verified Google
# address — including one with no account here yet, which it then creates.
# Set it to the domains you actually use, or leave GOOGLE_CLIENT_ID empty to
# disable Google sign-in entirely.
GOOGLE_ALLOWED_DOMAINS=""
GOOGLE_REDIRECT_URI="http://localhost:8080/api/v1/auth/google/callback"

# ── Frontend (.env.local) ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only backend address for the /api rewrite. Set this (instead of
# NEXT_PUBLIC_API_URL) to keep the backend URL out of browser bundles.
API_INTERNAL_URL=
NEXT_PUBLIC_SENTRY_DSN=
# Optional Sentry source-map upload — all three values are required to enable it.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
