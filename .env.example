# Backend .env
APP_NAME="ART Workspace API"
APP_VERSION="1.0.0"
# Use True only for local development. Keep False on deployed environments.
DEBUG=True

DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/art_workspace

SECRET_KEY="replace_with_a_long_random_secret"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=True
COOKIE_SAMESITE=none
AUTO_CREATE_TABLES=False
AUTO_MIGRATE_COLUMNS=False

# In production, replace localhost with the one exact frontend origin you use.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

BACKEND_MICROSOFT_TENANT_ID="common"
BACKEND_MICROSOFT_CLIENT_ID="xxxx-xxxx-xxxx"
BACKEND_MICROSOFT_CLIENT_SECRET="xxxx"
BACKEND_MICROSOFT_REDIRECT="http://localhost:8000/api/v1/auth/microsoft/callback"
FRONTEND_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

# Frontend .env.local
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=xxxx-xxxx-xxxx
