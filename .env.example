[TEMPLATE]
# ============================================================================
# ART Workspace — combined environment reference
# ----------------------------------------------------------------------------
# Backend:  copy the backend section into `backend/.env`
# Frontend: copy the frontend section into `frontend/.env.local`
# Never commit real .env files.
# ============================================================================

# ── Backend (.env) ───────────────────────────────────────────────────────────
APP_NAME="ART Workspace API"
APP_VERSION="1.0.0"
# Use True only for local development. Keep False on deployed environments.
DEBUG=True

DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/art_workspace
# Production runs on Aiven for PostgreSQL. Its project CA is not in certifi:
# download it (Service → Overview → CA certificate), place it on the backend
# host, and point this at the file so asyncpg verifies the server.
SSL_CA_CERT_PATH=

# JWT signing key. With DEBUG=False it must be at least 32 characters and must
# not be a known placeholder, or the API refuses to start.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="replace_with_a_long_random_secret"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie posture. `SameSite=None` is only accepted together with Secure/HTTPS;
# over plain local HTTP the backend downgrades it to `lax` automatically so the
# session cookie is not silently dropped.
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Local-development convenience only. The schema is owned by Alembic
# (`cd backend && alembic upgrade head`).
AUTO_CREATE_TABLES=False

# CSRF protection for cookie-authenticated writes (double-submit cookie).
# Disable only for non-browser API clients that cannot send X-CSRF-Token.
CSRF_PROTECTION_ENABLED=True
# Serve /docs, /redoc and /openapi.json. Always on when DEBUG=True.
ENABLE_API_DOCS=False

# Rate-limit storage. "memory://" is process-local and correct for a single
# instance; set a redis:// URI before scaling to more than one instance.
SLOWAPI_STORAGE_URI=memory://
# Per-IP request limits (requests per minute). Auth endpoints are the
# strictest; the avatar upload gets its own, tighter bucket because it is
# the heaviest authenticated write.
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_GENERAL_PER_MINUTE=120
RATE_LIMIT_WEATHER_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=5

# Who may create an account with EMAIL+PASSWORD: closed (only an
# admin can), approval (anyone may request one; it stays inactive until an
# admin approves) or open (self-registration works immediately).
REGISTRATION_MODE=approval

# ── Transactional email ─────────────────────────────────────────────────────
# console (default): nothing is delivered — messages are logged and kept in an
#   in-memory outbox (fine for tests/dev). smtp: any provider's SMTP relay.
#   resend: the Resend HTTP API. Password reset, email verification and the
#   approval notices all go through this one setting.
EMAIL_BACKEND=console
# From header, e.g. "ART Workspace <no-reply@yourdomain.com>".
EMAIL_FROM="ART Workspace <no-reply@artworkspace.local>"
# SMTP backend (Brevo / Gmail app password / SES / ...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=True
# Resend backend
RESEND_API_KEY=
# How long email links stay valid.
PASSWORD_RESET_TOKEN_MINUTES=30
EMAIL_VERIFY_TOKEN_MINUTES=1440
# Require a confirmed email before a password login succeeds. Leave False until
# a working EMAIL_BACKEND is configured, otherwise new users cannot get in;
# turn it on once delivery works.
REQUIRE_EMAIL_VERIFICATION=False

# ── Abuse protection ────────────────────────────────────────────────────────
# Cloudflare Turnstile secret (free). When set, /auth/register and
# /auth/forgot-password require a valid turnstile_token.
TURNSTILE_SECRET_KEY=
# Extra disposable-email domains to refuse at signup (comma-separated).
DISPOSABLE_EMAIL_DOMAINS=
# Terms revision recorded on consent (bump when the terms change).
TERMS_VERSION="2026-10"

# How long a deleted account stays in the admin panel's trash before it is
# purged for good. While it is there the admin can restore it, and its
# email/username stay reserved so the account returns to the same identity.
USER_DELETE_RETENTION_DAYS=30
# In production, replace localhost with the one exact frontend origin you use.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

FRONTEND_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Google OAuth client IDs accepted as a token audience (comma-separated; web
# and mobile clients have different IDs). With none set, Google sign-in fails
# closed.
GOOGLE_VALID_CLIENT_IDS=""
# Domains allowed to CREATE an account via Google (comma-separated, e.g.
# example.co.th). Existing accounts can always sign in, whatever this says.
# WARNING: while this is empty, a first Google sign-in creates an account for
# ANY verified Google address. Set it to the domains you actually use, or leave
# GOOGLE_CLIENT_ID empty to disable Google sign-in entirely.
GOOGLE_ALLOWED_DOMAINS=""
# Whether a FIRST Google sign-in may create an account, independent of
# REGISTRATION_MODE. True (default) keeps the historic behaviour: anyone with
# a verified Google email gets a working account. Set False to make Google
# creation follow REGISTRATION_MODE instead (closed refuses, approval queues).
GOOGLE_SIGNUP_ENABLED=True
GOOGLE_REDIRECT_URI="http://localhost:8080/api/v1/auth/google/callback"

# ── Frontend (.env.local) ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only backend address for the /api rewrite. Set this (instead of
# NEXT_PUBLIC_API_URL) to keep the backend URL out of browser bundles.
API_INTERNAL_URL=
NEXT_PUBLIC_SENTRY_DSN=
# Cloudflare Turnstile public site key (pairs with TURNSTILE_SECRET_KEY).
# When set, the sign-up and forgot-password forms render the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional Sentry source-map upload — all three values are required to enable it.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
