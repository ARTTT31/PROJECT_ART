# ============================================================================
# ART Workspace — combined environment reference
# ----------------------------------------------------------------------------
# Backend:  copy the backend section into `backend/.env`
# Frontend: copy the frontend section into `frontend/.env.local`
# Never commit real .env files.
# ============================================================================

# ── Backend (.env) ───────────────────────────────────────────────────────────
APP_NAME="ART Workspace API"
APP_VERSION="1.0.0"
# Use True only for local development. Keep False on deployed environments.
DEBUG=True

DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/art_workspace

# JWT signing key. With DEBUG=False it must be at least 32 characters and must
# not be a known placeholder, or the API refuses to start.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="replace_with_a_long_random_secret"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
AUTO_CREATE_TABLES=False
AUTO_MIGRATE_COLUMNS=False

# CSRF protection for cookie-authenticated writes (double-submit cookie).
# Disable only for non-browser API clients that cannot send X-CSRF-Token.
CSRF_PROTECTION_ENABLED=True
# Serve /docs, /redoc and /openapi.json. Always on when DEBUG=True.
ENABLE_API_DOCS=False

# In production, replace localhost with the one exact frontend origin you use.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

FRONTEND_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8080/api/v1/auth/google/callback"

# ── Frontend (.env.local) ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only backend address for the /api rewrite. Set this (instead of
# NEXT_PUBLIC_API_URL) to keep the backend URL out of browser bundles.
API_INTERNAL_URL=
NEXT_PUBLIC_SENTRY_DSN=
# Optional Sentry source-map upload — all three values are required to enable it.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
