# Database
DATABASE_URL=postgresql://art_user:art_password_dev@localhost:5432/art_workspace

# Security
# With DEBUG=False, SECRET_KEY must be at least 32 characters and must not be a
# known placeholder, or the API refuses to start.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-secret-key-change-in-production-min-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# CSRF protection (double-submit cookie) for cookie-authenticated writes.
# Disable only for non-browser clients that cannot send the X-CSRF-Token header.
CSRF_PROTECTION_ENABLED=True
# Serve /docs, /redoc and /openapi.json. Always on when DEBUG=True.
ENABLE_API_DOCS=False

# ⚠️ Database Schema Management — DEV ONLY shortcuts
# In PRODUCTION (Render/Vercel deployments) both must be False.
# Use Alembic instead: `cd backend && alembic upgrade head`
AUTO_CREATE_TABLES=True
AUTO_MIGRATE_COLUMNS=True

# ── Rate Limiting ──────────────────────────────────────────────────────────────
# Backend: "memory://" (single-pod default) or "redis://user:pass@host:port/db" (multi-pod)
SLOWAPI_STORAGE_URI=memory://
# Attempts per minute — stricter for auth endpoints
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_GENERAL_PER_MINUTE=120

# ── Error Monitoring (Sentry — OPTIONAL) ──────────────────────────────────────
# Leave SENTRY_DSN blank to disable. Get one at https://sentry.io/
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated exact frontend origins (wildcards are not allowed with cookies).
CORS_ORIGINS=http://localhost:3000

# ── Google OAuth (authorization-code flow) ────────────────────────────────────
# The frontend redirects to /api/v1/auth/google; Google calls back on
# GOOGLE_REDIRECT_URI, then the backend signs the user in and redirects to
# ${FRONTEND_URL}/login-success.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=ART Workspace API
APP_VERSION=1.0.0
DEBUG=True

# ── Web Push Notifications (PWA) ───────────────────────────────────────────────
# Generate keys using: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
