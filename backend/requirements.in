# Pins below are the current release of each library and `pip-audit` reports the
# set clean. Keep them in step with reality: stale pins are how python-jose 3.3.0
# stayed in the file long after the venv had moved on.
#
# Every floor also carries a ceiling. A bare `>=` lets pip resolve the next major
# with no commit in this repository, which is how sentry-sdk 3.0 took `mypy` down
# on a push that never touched the SDK; the caps name the major to migrate to when
# they are raised. scripts/check_requirements_caps.py fails CI on a floor without
# a ceiling, because a rule nobody checks rots.
#
# Test and lint tooling is not here. It lives in requirements-dev.in, because
# Render installs requirements.lock and pytest, flake8 and mypy have no business
# in a production image.
#
# FastAPI Framework
fastapi==0.165.0
uvicorn[standard]==0.54.0
python-multipart>=0.0.34,<1

# Database
# SQLAlchemy 2.1 made greenlet optional, where 2.0 pulled it in by itself on
# x86_64/arm64 — but the async engine imports it at runtime. Without the extra a
# fresh install resolves cleanly here (a developer venv still has greenlet from
# an older pin) and then every deploy dies on
# "The SQLAlchemy asyncio module requires that the Python 'greenlet' library is
# installed", so the `asyncio` extra is part of the pin, not an optional nicety.
sqlalchemy[asyncio]==2.1.9
psycopg2-binary==2.9.13
alembic==1.20.1

# Authentication & Security
# PyJWT replaced python-jose: jose 3.5.0 still carries CVE-2026-85394 with no fixed
# release, and its ecdsa/pyasn1 chain added advisories of their own. Tokens are
# HS256 in the same wire format, so sessions issued before the swap keep working.
pyjwt==2.15.1
argon2-cffi>=25.1.0,<26
pydantic[email]==2.14.3
pydantic-settings==2.16.3

# HTTP Requests
requests==2.34.2
httpx==0.28.1

# Google OAuth verification
google-auth>=2.62.2,<3

# Image processing (avatar normalisation — bounded WebP re-encode)
pillow==13.0.0

# PDF text extraction for the company holiday calendar import (pure Python).
pypdf==7.1.1
pywebpush==2.5.0

# Utilities
python-dotenv==1.2.4
# IANA timezone data for `zoneinfo`. Linux usually has /usr/share/zoneinfo,
# but Windows (and slim container images) do not, so `ZoneInfo("Asia/Bangkok")`
# in app/api/v1/endpoints/market.py raised ZoneInfoNotFoundError during test
# collection — pytest exited with code 4 before running a single test.
tzdata==2026.6

# Rate Limiting
slowapi==0.1.10

# Error Monitoring (optional — only active when SENTRY_DSN env var is set)
# Capped below 3: SDK 3.0 renamed profiles_sample_rate -> profile_session_sample_rate,
# dropped the transaction_style option and the `fastapi` extra, so the init() call in
# app/main.py stops type-checking. Raise the cap with that migration, not before.
sentry-sdk[fastapi]>=2.75.0,<3

# System Monitoring
psutil==7.2.2

# Horizontal scaling (optional). Redis backs the SlowAPI rate-limit storage
# (SLOWAPI_STORAGE_URI) and the WebSocket broadcast fan-out
# (WS_BROADCAST_REDIS_URL); the process-local defaults need neither.
redis>=8.1.0,<9

# ── Security floors for transitive dependencies ──────────────────────────────
# These are not imported directly. They are pinned because the resolver would
# otherwise happily install a version with open advisories, and the CI audit job
# should fail loudly if a future bump walks them back below these versions.
# Each keeps a major ceiling too, for the reason in the header above.
starlette>=1.10.0,<2      # every starlette < 1.3.1 advisory is still open (via fastapi)
cryptography>=50.0.2,<51  # required by google-auth, which allows much older releases
anyio>=4.16.0,<5          # three advisories fixed in 4.14.2 (via fastapi/httpx)
urllib3>=2.8.0,<3         # three advisories fixed in 2.8.0 (via requests)

asyncpg==0.32.0
