{
  "name": "art-workspace-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "playwright test",
    "test:e2e:live": "playwright test tests/e2e-live-backend.spec.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@sentry/nextjs": "^11.16.0",
    "@serwist/next": "^9.5.12",
    "clsx": "^2.1.0",
    "framer-motion": "^14.6.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.77.0",
    "next": "^16.4.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sweetalert2": "^11.26.25",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^26.6.5",
    "@types/qrcode.react": "^3.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "sharp": true,
    "unrs-resolver": true
  }
}
