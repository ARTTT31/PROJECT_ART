# API Configuration
# Public API URL used by browser requests. Leave empty to use the same-origin
# /api rewrite.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only backend address for the /api rewrite. Set this instead of
# NEXT_PUBLIC_API_URL to keep the backend address out of browser bundles.
API_INTERNAL_URL=

# Live notifications (WebSocket) origin. Usually leave this empty: the bell uses
# NEXT_PUBLIC_API_URL when set, and otherwise this site's own origin (the /api
# rewrite is expected to forward the upgrade). Set it only when the socket lives
# somewhere the HTTP API does not — e.g. if a hosting rewrite forwards plain
# requests but drops WebSocket upgrades.
NEXT_PUBLIC_WS_URL=

# Application
NEXT_PUBLIC_APP_NAME=ART Workspace
NEXT_PUBLIC_APP_VERSION=1.0.0

# Sentry Error Tracking
# DSN is public (safe for the browser). Source-map upload additionally requires
# SENTRY_AUTH_TOKEN, SENTRY_ORG and SENTRY_PROJECT.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
