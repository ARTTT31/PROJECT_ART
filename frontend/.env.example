# API Configuration
# Public API URL used by browser requests. Leave empty to use the same-origin
# /api rewrite.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only backend address for the /api rewrite. Set this instead of
# NEXT_PUBLIC_API_URL to keep the backend address out of browser bundles.
API_INTERNAL_URL=

# Live notifications (WebSocket) origin. Usually leave this empty: the bell uses
# NEXT_PUBLIC_API_URL when set, and otherwise this site's own origin (the /api
# rewrite is expected to forward the upgrade). Set it only when the socket lives
# somewhere the HTTP API does not — e.g. if a hosting rewrite forwards plain
# requests but drops WebSocket upgrades.
NEXT_PUBLIC_WS_URL=

# CCTV — deployment-managed HLS cameras (MediaMTX on Render).
# A JSON array; the page uses these only when the account has no saved layout.
# Each URL must point at that camera's MediaMTX manifest, for example:
# https://<render-service>.onrender.com/<camera-path>/index.m3u8
# MediaMTX must allow this site's origin (hlsAllowOrigins) for browser playback.
NEXT_PUBLIC_CCTV_STREAMS=[{"id":"front-door","name":"หน้าร้าน","location":"ภายนอก — ประตูหน้า","url":"https://art-workspace-cctv.onrender.com/camera1/index.m3u8","fps":25,"resolution":"1280x720"}]

# Application
NEXT_PUBLIC_APP_NAME=ART Workspace
NEXT_PUBLIC_APP_VERSION=1.0.0

# Sentry Error Tracking
# DSN is public (safe for the browser). Source-map upload additionally requires
# SENTRY_AUTH_TOKEN, SENTRY_ORG and SENTRY_PROJECT.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
